# Exclude everything
/*

# Except for default project files
!/.github
!/additional_install_files
!/aircast
!/build-aux
!/cmake
!/deps
!/docs
!/frontend
!/libobs*
!/plugins
!/shared
!/test
!.cirrus.yml
!.clang-format
!.editorconfig
!.gersemirc
!.git-blame-ignore-revs
!.gitattributes
!.gitmodules
!.gitignore
!.mailmap
!.swift-format
!AUTHORS
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!COC.rst
!COMMITMENT
!CONTRIBUTING.rst
!COPYING
!INSTALL
!README.rst

# Exclude lock files
*.lock.json

# Exclude files generated by Sphinx in-tree
/docs/sphinx/_build/*
!/docs/sphinx/_build/.gitignore
!/docs/sphinx/Makefile

# Exclude modified Flatpak files
build-aux/flatpak-github-action-modified-*

# Exclude macOS & Windows OS metadata
.DS_Store
Thumbs.db

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# Exclude patch backup/reject files (from applying aircast/patches/*.patch)
*.orig
*.rej

# Exclude editor, clangd, and IDE directories inside subdirectories
.vscode/
.idea/
.cache/
compile_commands.json
*.swp
*.swo
*~

# Exclude accidental in-tree build/compiler artifacts & logs inside subdirectories
plugins/aircast/build*/
_deps/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.log

# Exclude local environment/secret files
.env
.env.*
